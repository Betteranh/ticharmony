generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantType {
  INTERNAL
  CLIENT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WHATSAPP
}

enum ArticleVisibility {
  INTERNAL
  PUBLIC
}

enum Locale {
  FR
  EN
}

enum AssetType {
  LAPTOP
  DESKTOP
  SWITCH
  ROUTER
  SERVER
  PRINTER
  OTHER
}

enum AssetStatus {
  DEPLOYED
  IN_STOCK
  DISABLED
  RETIRED
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  type      TenantType
  address   String?
  locale    Locale     @default(FR)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users      User[]
  tickets    Ticket[]
  categories Category[]
  articles   KnowledgeArticle[]
  assets     Asset[]
  auditLogs  AuditLog[]

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  email        String
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  avatar       String     @default("🙂")
  roles        UserRole[]
  department   String?
  location     String?
  phone        String?
  locale       Locale     @default(FR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedTickets  Ticket[]       @relation("TicketRequester")
  assignedTickets   Ticket[]       @relation("TicketAssignee")
  comments          TicketComment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  assignedAssets    Asset[]
  licenses          UserLicense[]

  @@unique([tenantId, email])
  @@map("users")
}

model Category {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  nameFr   String @map("name_fr")
  nameEn   String @map("name_en")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  articles KnowledgeArticle[]

  @@map("categories")
}

model Ticket {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  number      Int
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  categoryId  String?        @map("category_id")
  requesterId String         @map("requester_id")
  assigneeId  String?        @map("assignee_id")
  slaDueAt    DateTime?      @map("sla_due_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  closedAt    DateTime?      @map("closed_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?         @relation(fields: [categoryId], references: [id])
  requester   User              @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  body       String
  isInternal Boolean  @default(false) @map("is_internal_note")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@map("ticket_comments")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  commentId  String?  @map("comment_id")
  fileUrl    String   @map("file_url")
  filename   String
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  type      String
  channel   NotificationChannel
  payload   Json
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model KnowledgeArticle {
  id         String            @id @default(cuid())
  tenantId   String?           @map("tenant_id")
  categoryId String?           @map("category_id")
  titleFr    String            @map("title_fr")
  titleEn    String            @map("title_en")
  bodyFr     String            @map("body_fr")
  bodyEn     String            @map("body_en")
  visibility ArticleVisibility @default(INTERNAL)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("knowledge_articles")
}

model Asset {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  assetTag     String      @map("asset_tag")
  type         AssetType
  model        String
  status       AssetStatus @default(IN_STOCK)
  assigneeId   String?     @map("assignee_id")
  location     String?
  serialNumber String?     @map("serial_number")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes    AssetNote[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, type])
  @@map("assets")
}

model AssetNote {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  label     String
  value     String
  sensitive Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_notes")
}

model UserLicense {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  email     String
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_licenses")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
